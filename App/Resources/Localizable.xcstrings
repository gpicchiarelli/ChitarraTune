    "primer.body": {
      "comment": "Body of the screen shown before the system microphone prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To measure the pitch of your guitar, the tuner listens through the microphone. Next, your device will ask you to allow it."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per misurare l'intonazione della chitarra, l'accordatore ascolta dal microfono. Tra un attimo il dispositivo ti chiederà di consentirlo."
          }
        }
      }
    },
