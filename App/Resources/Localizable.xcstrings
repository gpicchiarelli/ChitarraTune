    "failure.denied.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow microphone access in Settings so ChitarraTune can hear your guitar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l'accesso al microfono nelle Impostazioni per permettere a ChitarraTune di sentire la chitarra."
          }
        }
      }
    },
    "failure.denied.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone Access Is Off"
