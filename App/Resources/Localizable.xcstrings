      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sound is analyzed on this device as you play. It is never recorded, stored or sent anywhere."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suono viene analizzato su questo dispositivo mentre suoni. Non viene mai registrato, salvato né inviato."
