    "failure.interrupted.message": {
      "comment": "Message when a call or another app interrupted listening",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A call or another app took over the microphone. Listening resumes by itself when it ends, or you can start again now."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una chiamata o un'altra app ha preso il microfono. L'ascolto riprende da solo quando finisce, oppure puoi riavviarlo subito."
          }
        }
      }
    },
    "failure.interrupted.title": {
      "extractionState": "manual",
