    "failure.engine.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audio engine didn't start. Make sure no other app is using the microphone, then try again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il motore audio non è partito. Verifica che nessun'altra app stia usando il microfono e riprova."
          }
        }
      }
    },
    "failure.engine.title": {
      "extractionState": "manual",
      "localizations": {
