{
  "sourceLanguage": "en",
  "strings": {
    "%@": {
      "comment": "An audio input's own name, shown as is (Shortcuts).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        }
      }
    },
    "%@ — %@": {
      "comment": "A row in the tuning picker: the tuning's name, then its strings.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — %2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — %2$@"
          }
        }
      }
    },
    "a11y.autoHint": {
      "comment": "Hint of the Auto chip",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detects which string you play"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconosce da sola la corda che suoni"
          }
        }
      }
    },
    "a11y.cents.flat": {
