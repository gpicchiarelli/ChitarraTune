    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ChitarraTune listens to your guitar through the microphone to measure its pitch. Audio is analysed on the device and never recorded or sent anywhere."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ChitarraTune ascolta la chitarra tramite il microfono per misurarne l'intonazione. L'audio è analizzato sul dispositivo e non viene mai registrato o inviato."
          }
        }
      }
    }
  },
  "version": "1.0"
