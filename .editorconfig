root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,xcconfig}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Xcode owns the string catalogs: it rewrites each one whole and never ends it with a newline.
# Asking for one here would turn every localisation edit into a diff with a spurious last line.
[*.xcstrings]
insert_final_newline = false

[*.pbxproj]
indent_style = tab
