// Base.xcconfig — build settings shared by every configuration and target.
// Local, untracked overrides go in Config/Local.xcconfig (git-ignored). The signing team below is the
// maintainer's and is only a default: a Team ID is public (it is in every signed binary), and anyone
// else sets their own DEVELOPMENT_TEAM in Local.xcconfig.

// MARK: Versioning (CI overrides MARKETING_VERSION from the tag, CURRENT_PROJECT_VERSION from the run number)
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1
GIT_COMMIT = dev

// MARK: Platforms — one multiplatform target: macOS, iPhone and iPad
SDKROOT = auto
SUPPORTED_PLATFORMS = iphoneos iphonesimulator macosx
MACOSX_DEPLOYMENT_TARGET = 27.0
IPHONEOS_DEPLOYMENT_TARGET = 27.0
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO

// MARK: Swift
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_UPCOMING_FEATURE_EXISTENTIAL_ANY = YES
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES
SWIFT_UPCOMING_FEATURE_NONISOLATED_NONSENDING_BY_DEFAULT = YES
// Everything is an error except a deprecation (see Packages/ChitarraTuneKit/Package.swift): a
// yearly SDK must be able to deprecate an API without turning the build red on a morning nobody
// touched the code. The warning stays on screen until there is a stable successor to move to.
OTHER_SWIFT_FLAGS = $(inherited) -warnings-as-errors -Wwarning DeprecatedDeclaration

// MARK: Security & hygiene
ENABLE_ENHANCED_SECURITY = YES
ENABLE_HARDENED_RUNTIME = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
DEAD_CODE_STRIPPING = YES
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
CLANG_WARN_DOCUMENTATION_COMMENTS = YES
CLANG_WARN_UNGUARDED_AVAILABILITY = YES_AGGRESSIVE
GCC_WARN_64_TO_32_BIT_CONVERSION = YES

// MARK: Resources
STRING_CATALOG_GENERATE_SYMBOLS = YES
ASSETCATALOG_COMPILER_GENERATE_ASSET_SYMBOLS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
SWIFT_EMIT_LOC_STRINGS = YES

// MARK: Signing (automatic; CI builds with CODE_SIGNING_ALLOWED=NO)
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = 7722WYMVXU

#include? "Local.xcconfig"
