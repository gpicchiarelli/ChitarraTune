<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the Info.plist Xcode generates from INFOPLIST_KEY_* settings. -->
	<key>ChitarraGitCommit</key>
	<string>$(GIT_COMMIT)</string>
	<!-- macOS: the app keeps no unsaved state, so the system may terminate it when idle and hidden.
	     Listening holds a ProcessInfo activity that suppresses this while the microphone is in use. -->
	<key>NSSupportsAutomaticTermination</key>
	<true/>
	<key>NSSupportsSuddenTermination</key>
	<true/>
</dict>
</plist>
