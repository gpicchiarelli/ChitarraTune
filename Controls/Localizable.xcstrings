    "control.start.description": {
      "comment": "Description of the Start Tuning control in the controls gallery",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens ChitarraTune and starts listening to your guitar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre ChitarraTune e inizia ad ascoltare la chitarra."
          }
        }
      }
    },
